{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git *)",
      "Bash(bash scripts/test-backend.sh*)",
      "Bash(npm.cmd *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"[Console]::OutputEncoding=[System.Text.Encoding]::UTF8; if (Test-Path '.ai/CHECKPOINT.local.md') { Write-Output '=== Resuming from .ai/CHECKPOINT.local.md (run /checkpoint to refresh) ==='; Get-Content '.ai/CHECKPOINT.local.md' -Raw -Encoding UTF8 }\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "git diff --check" }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          { "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/high-risk-task-guard.ps1" }
        ]
      }
    ]
  }
}
