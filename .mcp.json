{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--network",
        "host",
        "mcr.microsoft.com/playwright/mcp:latest",
        "--headless",
        "--browser",
        "chrome",
        "--no-sandbox",
        "--isolated",
        "--caps",
        "vision",
        "--image-responses",
        "allow"
      ]
    }
  }
}
