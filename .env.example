# 复制为 .env 并填值；.env 已被 .gitignore 忽略，不入库。
# base docker-compose.yml 的 ${VAR:-default} 仅供本地/演示回退；生产必须覆盖所有默认凭据。

# ── PostgreSQL（db / backend / data-loader）──────────────────────────────────
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── Neo4j（neo4j / backend / data-loader）────────────────────────────────────
NEO4J_USERNAME=
NEO4J_PASSWORD=

# ── Redis（redis / backend）──────────────────────────────────────────────────
# Required. Passed to redis-server --requirepass and to the backend REDIS_PASSWORD env var.
# Both are set by the same variable; the compose file injects it into both services.
REDIS_PASSWORD=

# ── RRN HMAC pepper（ADR-0024 — backend RRN_HASH_PEPPER）────────────────────
# Required. Inject via secret manager in production; must NOT use default value.
# See ADR-0024 + ADR-0025 (rotation). Keep separate from DB backup/snapshot.
RRN_HASH_PEPPER=

# ── 摄像头流密码加密（SEC-0026 / ADR-0026 — backend）─────────────────────────
# docker-compose.yml 的 backend 服务以 ${VAR:?must be set} 强制读取这两项（缺失则 compose 报错）。
# CAMERA_STREAM_AES_KEY_V1：AES-256-GCM 主密钥；生成 `openssl rand -base64 32`；
#   仅注入 Java 后端，绝不下发给 AI 容器（密钥只在 Java，AI 仅经 HTTP 取明文）。缺失则后端 fail-fast。
# AI_SERVICE_TOKEN：AI 服务调内部凭据接口的共享 Bearer token；生成 `openssl rand -base64 32`；
#   必须与 AI 栈（ai/.env.example）的 AI_SERVICE_TOKEN 同值。
CAMERA_STREAM_AES_KEY_V1=
AI_SERVICE_TOKEN=
# 注：AI 为独立 compose 栈（ai/docker-compose.yml）；其 JAVA_BACKEND_URL 与 AI_SERVICE_TOKEN 见 ai/.env.example。

# ── 证据对象存储（D-STORE / wire-detection-evidence-readback — minio / backend）────────────
# MinIO 留内网，backend 反代读取（非 presigned 直连浏览器）。docker-compose.yml 的 minio 服务以
# ${VAR:?must be set} 强制读取 ACCESS/SECRET KEY（缺失则 compose 报错）；ENDPOINT/BUCKET 有内网默认值
# （分别为 http://minio:9000 / ai-kids-care，与 db/initdb 种子的 storage_uri s3://ai-kids-care/... 对齐），
# 通常无需覆盖。
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY：MinIO root 凭据（同时用作 minio-init 引导桶的 mc 凭据）；
#   生成示例：openssl rand -hex 16 / openssl rand -base64 24
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# 可选覆盖（一般留空吃 compose 默认值）：
# MINIO_ENDPOINT=http://minio:9000
# MINIO_BUCKET=ai-kids-care

# ── 生产 overlay（docker-compose.prod.yml：Caddy 边缘 TLS + Secure 会话 cookie）──
# 仅生产部署需要；演示 / CD 路径可留空。会话机制为服务端 session（ADR-0016，
# 取代 JWT——原 JWT_SECRET 已废弃，故此处不再列出）。TLS 见 ADR-0017。
#   SESSION_COOKIE_SECURE  会话 cookie 标记 Secure（仅经 HTTPS 下发）；生产须 true
#   DOMAIN                 Caddy 自动 ACME 证书签发的公网域名；生产必填
#   ACME_EMAIL             ACME 注册邮箱（证书到期 / 吊销通知）
SESSION_COOKIE_SECURE=
DOMAIN=
ACME_EMAIL=

# ── EMAIL 通道 SMTP（wire-email-notification-channel — backend）──────────────
# ESCALATED 家长告警叠加渠道（PUSH+SMS 之外的第三条留痕渠道）。docker-compose.yml 对这四项设有
# 内置占位默认值（未覆盖时 compose up 仍可启动，该渠道会 FAILED/超时但不影响 PUSH/SMS），此处留空
# 即沿用占位默认；生产部署必须覆盖为真实 SMTP relay 凭据（SES-SMTP / 企业邮 / Naver 等）。
# MAIL_PORT 常见值：587（STARTTLS）/ 465（SMTPS）/ 25。
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# ── GHCR pull credentials (ADR-0022 CD) — used by watchtower on the deploy host via
# REPO_USER/REPO_PASS in docker-compose.cd.yml. Only needed on the deploy host.
#   GHCR_USER = your GitHub username
#   GHCR_PAT  = a classic Personal Access Token with the read:packages scope
GHCR_USER=
GHCR_PAT=
