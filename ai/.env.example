PYTHONPATH=src
AI_MODEL_DIR=outputs/videomae_baseline/best_model
AI_DEVICE=
AI_NUM_FRAMES=16
AI_SAMPLING_RATE=4
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
# SEC-03 (harden-ai-serving, C3): Bearer token required by the FastAPI serving path's
# /predict/upload endpoint. Distinct secret from AI_SERVICE_TOKEN below (that one is the
# AI->backend ingest direction) — do not reuse the same value. The service fails fast at
# startup if this is unset/blank.
AI_INFERENCE_TOKEN=
# Max upload size (MB) enforced by /predict/upload before the file is fully buffered (SEC-04).
AI_MAX_UPLOAD_MB=512
# Internal credential endpoint base URL (default matches docker-compose.yml service name 'backend')
JAVA_BACKEND_URL=http://backend:8080
# Shared Bearer token for AI service authentication; must match Java backend AI_SERVICE_TOKEN env.
# Required by the live-detection supervisor (it fails fast if empty).
AI_SERVICE_TOKEN=
# AI model row id (ai_models) submitted with each detection session (closed-loop step 4).
# Worker-side fallback only — the active-stream registry returns a per-stream modelId.
MODEL_ID=1

# --- Multi-camera live-detection supervisor (scripts/stream_supervisor.py, Scheme A) ---
# The supervisor enumerates the active streams via GET /api/v1/internal/streams and runs one
# detection worker per stream — no per-stream STREAM_ID env is needed any more.
# Max concurrent worker subprocesses (capacity guard).
MAX_WORKERS=8
# How often (seconds) the supervisor re-polls the registry and reconciles the worker set.
STREAM_POLL_INTERVAL_SEC=30

# --- Single-stream fallbacks (scripts/stream_live_alert_service.py __main__, independent test) ---
# A single camera stream ID to fetch credentials for (ADR-0026 Phase 3). Not used by the supervisor.
STREAM_ID=
# Production FLV stream URL, e.g. http://host:port/live/stream.flv (legacy direct-URL fallback).
STREAM_URL=