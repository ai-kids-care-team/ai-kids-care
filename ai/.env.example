PYTHONPATH=src
AI_MODEL_DIR=outputs/videomae_baseline/best_model
AI_DEVICE=
AI_NUM_FRAMES=16
AI_SAMPLING_RATE=4
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=
# Comma-separated Pushover user keys for multi-recipient notifications (used by stream_live_alert_service.py).
# Takes precedence over PUSHOVER_USER_KEY when set.
PUSHOVER_USER_KEYS=
# Production FLV stream URL, e.g. http://host:port/live/stream.flv
STREAM_URL=
# Internal credential endpoint base URL (default matches docker-compose.yml service name 'backend')
JAVA_BACKEND_URL=http://backend:8080
# Camera stream ID to fetch credentials from Java backend (ADR-0026 Phase 3)
STREAM_ID=
# Shared Bearer token for AI service authentication; must match Java backend AI_SERVICE_TOKEN env
AI_SERVICE_TOKEN=